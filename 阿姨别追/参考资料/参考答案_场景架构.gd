extends Node
## ============================================================
## 参考答案 · 场景架构（总管 + 代理）
## ------------------------------------------------------------
## 这份不参与游戏运行，是给你看的。正式版拆成三个文件：
##   单例/场景总管.gd            全局唯一，只管转发
##   场景/楼层代理/楼层代理.gd    每层一个，管这层具体的东西
##   交互物/门/门.gd             一扇门自己记「开到哪儿了」
##
## 这份答案把三个揉在一页，让你一眼看出「谁跟谁说话」。
## 你自己动手改，改坏了不影响游戏 —— 这就是参考答案的用处。
##
## 【更新说明】「楼层代理」（每层一个）已经改成全场景一个的「物件代理」，
## 按楼层/层带那一套也换成了「按编号」。思路仍然适用，名字对不上的时候
## 以同目录《参考答案_物件代理.gd》为准。
## ============================================================


# ============================================================
# 第一段：总管 —— 就是你写的「总体的全部管线」
# ------------------------------------------------------------
# 它不干活，只记「哪层归谁管」，然后把话递过去。
# 学生不用知道门在哪，喊一句「我按了东西」，总管负责找人。
# ============================================================

# 记：楼层号 -> 那层的代理
# 用「字典」记，就像一张两列的表格：左边写"一楼"，右边写"一楼的代理是谁"
var _floors: Dictionary = {}


## 楼层出生时来报个到。改「一楼」为「二楼」，这一层就归新的代理管
func 登记(楼层号: String, 代理) -> void:
	_floors[楼层号] = 代理


## 上报一件事。谁都往这儿喊，不用管谁会处理
## 例：report("一楼", "door_pressed", {"door_id": "1-走廊东"})
func 上报(楼层号: String, 事情: String, 数据: Dictionary) -> void:
	var 代理 = _floors.get(楼层号)
	if 代理 == null:
		print("没这一层：", 楼层号)      # 说话没人接，至少喊一声
		return
	代理.on_report(事情, 数据)             # 把话递给这层的代理


# ============================================================
# 第二段：楼层代理 —— 你写的「各个地方有各个的代理」
# ------------------------------------------------------------
# 它只认自己那一层。开局读清单、把东西建出来；有人上报，它照单处理。
# 五层楼用的是同一份脚本，只是挂上去时把 floor_id 改了。
# ============================================================

# 这一层叫什么。要和清单里的名字对得上
#（正式图：数据/正式/楼层清单.gd；测试布景：数据/测试/楼层清单_旧一楼.gd）
var floor_id: String = "一楼"

# 编号 -> 门。以后灯、柜子也各有一本这样的账
var _doors: Dictionary = {}


## 开局照清单建门。注意：脚本里没有写死任何一个坐标，全从数据文件读
func 建门(清单: Dictionary) -> void:
	for 一条 in 清单.get("门", []):
		print("在这一格建一扇门：", 一条["编号"], " 位置 ", 一条["位置"])
		# 正式版这里是：门场景.instantiate() → add_child → setup(楼层, 编号, 位置)
		# _doors[一条["编号"]] = 门节点


## 总管把话递到这儿。以后「灯要亮」「柜子弹开」也走这一个口
func on_report(事情: String, 数据: Dictionary) -> void:
	if 事情 == "door_pressed":
		print("[", floor_id, "] 收到：", 数据.get("door_id"), " 被按了")
		# 正式版这里会顺手记一笔，比如「谁在哪扇门前」，W4 宿管要用来判断


# ============================================================
# 第三段：门 —— 「抢使用权」到底怎么算
# ------------------------------------------------------------
# 门不记「这扇门归谁」，只记两个数：
#   _amount  开到哪儿了（0=全关，1=全开）
#   _user    现在是谁在推
#
# 谁按 E，谁就把 _user 换成自己，然后把方向反过来。
# 门从当前位置继续走，不清零 —— 这就是「抢」。
# ============================================================

var _amount: float = 0.0   # 门现在开到哪：0 = 全关，1 = 全开
var _target: float = 0.0   # 门要去哪：0 = 全关，1 = 全开
var _user = null

# 注：真实版这两个数不写在门里，也不挂在人身上 —— 它们住在
# 数据/通用规则.gd 的「默认开门用时」里（全地图共用），每扇门还能单独覆盖。
# 这里先简化成两个常量，是为了把「谁在推 → 用几秒」这条线讲清楚。
const 学生用时: float = 0.3
const 宿管用时: float = 1.5


## 有人按 E。改这两个数字就是改手感
func 按下(谁) -> void:
	_user = 谁                                   # 换人
	# 现在开着就往关走，现在关着就往开走
	if _amount > 0.5:
		_target = 0.0                           # 目标改成全关
	else:
		_target = 1.0                           # 目标改成全开


## 每帧朝目标挪一点。速度只看「现在是谁在推」
func 每帧(delta: float) -> void:
	var 用时: float = 宿管用时 if _is_keeper(_user) else 学生用时
	_amount = move_toward(_amount, _target, (1.0 / 用时) * delta)


func _is_keeper(谁) -> bool:
	return 谁 != null and 谁.is_in_group("keeper")


# ============================================================
# 你要改的东西，就三个地方
# ------------------------------------------------------------
# 1. 加一扇门      → 改这张图的坐标表（数据/正式/ 或 数据/测试/），往「门」里加一行
# 2. 改开门快慢    → 改 数据/通用规则.gd 顶部的「默认开门用时」（对所有地图生效）；
#                    只想让某一扇门特殊，就在那扇门的条目里加 "开门用时"
# 3. 加一种新东西  → 在代理里照「建门」再写一段（建灯、建柜子），
#                    在 on_report 里加一个 if 分支
#
# 这三条做到了，就说明这套架构真的省事：加东西只改表和代理，
# 不用动学生、不用动总管、不用动别的层。
# ============================================================
