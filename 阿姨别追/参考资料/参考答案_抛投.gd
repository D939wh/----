extends RefCounted
## ── 参考答案 · 蓄力抛投（2026-11-09）────────────────────────────
##
## 这份**不参与运行**，只用来给你看懂「按住 F 蓄力、松手把东西扔出去」整件事。
## 正式版拆在两个地方：
##   · 组件/抛投/抛投.gd     —— 抛物线本身（下面 ① 是它的完整镜像，代码与正式版一致，差异只在注释）
##   · 角色/学生/student.gd  —— 蓄力计时、按档位算距离、起飞前关碰撞（②③④ 只讲思路）
##
## 谁在用这套：可搬运箱子（被扔出去）+ 学生（被队友扔出去）。
## 两边共用同一个组件、同一个出手角 —— 「箱子怎么飞」和「人怎么飞」是同一套数，
## 调一次公式，两边一起变，不会各飞各的。
##
## 铁律（和 组件/状态机/ 那条一模一样）：这个文件只认「飞多远、地面在哪一层」，
## 不认识箱子，也不认识人 —— 游戏名词一个不许出现。


# ══════════════════════════════════════════════════════════
# ① 抛物线组件（正式版镜像，代码未动）
# ══════════════════════════════════════════════════════════
#
# 【它是什么】RefCounted：不用进节点树的轻量对象，new 出来就能用，
# 没人引用了引擎自动回收。为什么不是 Node：它不需要出现在场景里、
# 不需要被引擎每帧点名 —— 什么时候飞、飞多远全由宿主说了算，
# 它只是一本「会算抛物线的公式手册」。（状态机也是这个套路。）
#
# 【思路】不做真实物理模拟（RigidBody 那种谁也说不准的弹跳），要的是确定感：
# 你说「飞 176 像素」，它就正好落在 176 像素。所以是反着来的 ——
# 先拿「想飞多远」把初速算出来，再照着这条弧线飞。三步：
#   起飞()   拿「想飞多远 + 出手点离地多高」反解出 45° 初速
#   推进()   每帧把位移拆成 ≤6px 的小步，一步步挪：每步探墙，下落段探地
#   探脚下() 从身体底边往下打一条短射线（箱子站着往下掉也是这个问法）

const 出手角 := 0.70710678   # 45° 的正弦 / 余弦（45° 时两个值相等，一个数两用）
const 每步上限 := 6.0        # 一帧的位移拆成 ≤6px 的小步，免得穿过墙和地板

var 重力: float = 900.0
var 最大速度: float = 700.0      # 再快也不会穿地：一帧最多 700/60 ≈ 12px
var 底半高: float = 0.0          # 原点离底边多远：学生原点在脚底 → 0；箱子在中心 → 半高
var 半宽: float = 8.0
var 地面层: int = 1              # 探地面 / 探墙认哪层（宿主照规则表设，这里不写死）

var _速度: Vector2 = Vector2.ZERO
var 在飞: bool = false


## 起飞。`平抛距离` 从出手点算起；≤2px 当作原地放下，返回 false。
## `横` = 往哪边（±1）。`地面y` 由调用方给：贴着地的东西从自己身上打射线，
## 会从地面下方穿出去、量到地板底面，高度就错了。
#
# 【为什么 ≤2px 就不飞】「轻点一下 F」是玩家想说「放这儿」，
# 不是「扔 0 像素」—— 原地放下走的是放下那套摆位（摆在脚边、贴地），
# 真起飞反而会先被抬到半空再落一次，看着像抽风。
#
# 【离地为什么要补进公式】出手点越高、飞行时间越长、飞得越远。
# 同一个初速从楼上扔和从地面扔落点差一截 —— 所以先把「现在离地多高」量出来，
# 喂给下面的 _初速，让它把这段多出来的距离扣回去。
func 起飞(宿主: Node2D, 横: float, 平抛距离: float, 地面y: float) -> bool:
	在飞 = false
	if 平抛距离 <= 2.0:
		return false
	if 横 == 0.0:
		横 = 1.0
	# 出手点离地多高？越高飞得越远，所以要把这段补进公式。
	var 离地 := 地面y - (宿主.global_position.y + 底半高)
	if 离地 < 0.0:
		宿主.global_position.y = 地面y - 底半高   # 拖行档本来就压在地里，出手前先抬到地面
		离地 = 0.0
	var v := _初速(平抛距离, 离地)
	_速度 = Vector2(signf(横) * v * 出手角, -v * 出手角)
	在飞 = true
	return true


## 45° 出手时 d = v²/g；起点有高度 h 就更远，迭代几次把 v 收回来。
## 「向上」的初速是正数（Godot 里 y 向下为正，落到 `_速度` 时才写负号）。
#
# 【迭代修正是什么】公式 d = v²/g 只在「从地面出手、落回地面」时严格成立；
# 出手点比落地点高（比如站在楼上往下扔）时，实际会飞得比 d 远。
# 一次算不准没关系：先按公式猜一个 v → 算出「按这个 v 实际会落在哪」→
# 拿「想要的落点 ÷ 算出的落点」修正 v → 再算一遍。每修一轮误差平方级缩小，
# 6 轮足够把误差压到 0.01px 以下。这种「猜 → 验 → 修」的循环就叫迭代。
func _初速(平抛距离: float, 离地: float) -> float:
	var v := sqrt(平抛距离 * 重力)
	for _i in 6:
		var 上 := v * 出手角
		var 落地用时 := (上 + sqrt(上 * 上 + 2.0 * 重力 * 离地)) / 重力
		var 落点 := 上 * 落地用时
		if 落点 <= 0.01:
			break
		v *= sqrt(平抛距离 / 落点)
	return v


## 推进一帧。返回 true = 这一帧落地了（`在飞` 已置 false，宿主自己收尾）。
#
# 【为什么拆小步】一帧飞 12px，墙只有 16px 厚的话「一步跨过去」引擎根本没看见墙。
# 拆成 ≤6px 的小步、每步都问一次「前面有没有墙 / 脚下有没有地」，
# 才能稳稳贴在墙面上往下滑，而不是穿过去。
#
# 【为什么只有往下走才探地】刚出手那几步是向上飞的，
# 脚下 2px 之内本来就有地面（人还站在原地附近），这时报「落地」会立刻趴窝。
func 推进(宿主: Node2D, delta: float) -> bool:
	if not 在飞:
		return false
	_速度.y = minf(_速度.y + 重力 * delta, 最大速度)
	var 位移 := _速度 * delta
	var 步数 := maxi(1, ceili(位移.length() / 每步上限))
	var 步 := 位移 / float(步数)
	for _i in 步数:
		if absf(步.x) > 0.001 and _撞墙(宿主, 步.x):
			_速度.x = 0.0            # 撞墙就贴在墙上往下掉，不穿过去
		else:
			宿主.global_position.x += 步.x
		# 只有往下走才看地面：刚出手时向上抛，脚下 2px 就报落地，会立刻停住
		if 步.y > 0.0:
			var 命中 := 探脚下(宿主, 步.y + 2.0)
			if not 命中.is_empty():
				宿主.global_position.y = float(命中["position"].y) - 底半高
				_速度 = Vector2.ZERO
				在飞 = false
				return true
		宿主.global_position.y += 步.y
	return false


## 从身体底边往下探一条射线（空字典 = 脚下是空的）。
## 自由落体也用得上，所以是公开的。
## 排除宿主自己：学生自己就站在「地板层」，不排除的话射线一出手就撞在自己身上。
#
# 【射线是什么】从一点朝一个方向问一句「最先撞到谁、撞在哪」，
# 只认 `地面层` 这一层 —— 梯子、道具这些感应区不算「地」。
func 探脚下(宿主: Node2D, 探距: float) -> Dictionary:
	var 起点 := 宿主.global_position + Vector2(0.0, 底半高 - 2.0)
	var 查询 := PhysicsRayQueryParameters2D.create(
		起点, 起点 + Vector2(0.0, maxf(探距, 0.0) + 2.0), 地面层)
	查询.collide_with_areas = false    # 只认实心地面，不认梯子/道具这些感应区
	查询.collide_with_bodies = true
	var 排出: Array[RID] = [宿主.get_rid()]
	查询.exclude = 排出
	return 宿主.get_world_2d().direct_space_state.intersect_ray(查询)


## 这一步会不会撞到墙。只认实心块，不认感应区。
func _撞墙(宿主: Node2D, 步长: float) -> bool:
	var 起点 := 宿主.global_position + Vector2(signf(步长) * 半宽, 0.0)
	var 查询 := PhysicsRayQueryParameters2D.create(
		起点, 起点 + Vector2(步长, 0.0), 地面层)
	查询.collide_with_areas = false
	查询.collide_with_bodies = true
	var 排出: Array[RID] = [宿主.get_rid()]
	查询.exclude = 排出
	return not 宿主.get_world_2d().direct_space_state.intersect_ray(查询).is_empty()


# ══════════════════════════════════════════════════════════
# ② 蓄力那一套（都在 student.gd，这里只讲流程）
# ══════════════════════════════════════════════════════════
#
# 箱子和队友走同一条路，一个字不差：
#
#   F 按下  →  _交互键()：手上有东西（箱子或队友）→ _开始蓄力()；
#              空手 → 照旧按优先级找（箱子/道具 → 扛队友）
#   按住    →  _推进蓄力(delta)：进度每帧加秒，封顶「满蓄力时长」；
#              这时候按住左/右还能改扔的方向（朝向是松手前最后一刻说了算）
#   头顶    →  借的通用读条（就是拉人那根），只画不数秒，进度由蓄力这边喂
#   松手 F  →  _松开交互()：比例 = 已蓄时长 ÷ 满蓄力时长（0~1），
#              再按手上有谁分派：_抛出箱子(朝向, 比例) 或 _抛出同学(朝向, 比例)
#   被打断  →  _取消蓄力()：东西还在手上、条收掉。挨打、被扛走、切状态都会走到它
#              （每个状态脚本的 离开() 也调一次，所以怎么切状态力条都不会留在头顶）
#
# 【蓄力时为什么别的键一律不接】（正常.gd 的 _处理按键 里先判 蓄力中()）
#   半路去开门 / 用道具，会把「扔多远」这件事搅乱，力条也会突然消失 ——
#   玩家会以为自己按坏了。蓄力是一件完整的事，做完或者取消，没有第三条路。
#
# 【为什么短按 = 原地放下】玩家「轻点一下 F」的意思是「放这儿」，
# 不是「扔 0 像素」。距离 ≤ 2px 时 _抛出同学 直接走 放下同学() 的老摆位，
# _抛出箱子 走 放下那一套贴地逻辑，都不真起飞（组件 起飞() 对 ≤2px 也返回 false，双保险）。

# ══════════════════════════════════════════════════════════
# ③ 扔多远 —— 档位说了算（和走多慢、跳多矮是同一张表）
# ══════════════════════════════════════════════════════════
#
#   极限距离 = 最轻档身位(4) − (档号 − 1) 个身位
#   → 1 档 4 身位 / 2 档 3 / 3 档 2 / 4 档 1 —— 越重扔得越近
#   实际距离 = 极限 × 蓄力比例（半蓄 = 一半）
#
#   身位 = 学生碰撞体的高 = 44px（一个「人高」当尺子，比像素好聊）
#   队友固定 45kg = 3 档 → 满蓄正好 2 身位；最轻的箱子 1 档 → 4 身位
#
# 【为什么把出手点那一段扣掉】身位是从「人」量起的，
# 不是从「手」量起 —— 箱子出手前挂在身前 14~18px，
# 这段白送的距离先扣掉（_抛出箱子 / _抛出同学 里的 距离 := … − absf(起点.x)），
# 不然实际落点永远比标的远一截。
#
# 【顺手记的档号】_应用负重() 现在多抄一个 _档号 ——
# 拿起时看一眼表记下来，抛投时直接用，不用再查（和移速倍率同一个套路）。

# ══════════════════════════════════════════════════════════
# ④ 被扔的人这边（学生当「货物」，状态机怎么接）
# ══════════════════════════════════════════════════════════
#
#   扔出去  →  抛出去(方向, 距离, 地面y)：调组件起飞，起飞前把自己的碰撞体关掉
#              （不然飞行中被墙一挤，物理引擎会把他弹飞）
#   飞行中  →  抢占() 认「被扛着 **或** 在飞」→ 进「被拎」状态；
#              被拎.gd 每帧只干一件事：在飞就 _飞(delta) 推一帧
#              —— 「身体不由自己做主」的两种情况共用一个状态，没加新状态文件
#   落地    →  组件探到地面返回 true → 碰撞体挂回去 → 下一帧抢占自动接回
#              正常 / 瘫痪（扔之前瘫没瘫，原样保留）
#   空中    →  抓不到也扛不走：_贴身队友() 排除 在飞() 的人；
#              半空被接住 → 被扛起() 里清掉 在飞，飞行作废，交给扛他的人
#
# 【为什么落地不自己切状态】「落地了」是物理事实，「该回哪个状态」是抢占的账。
# 状态机铁律：抢占只回答「该在哪个状态」。落地的人下一帧被抢占接走，
# 这段代码就不用关心「我之前是瘫的还是站的」—— 少一层记性，少一个 bug 口。

# ══════════════════════════════════════════════════════════
# ⑤ 想调手感，动这三个数（都在上面，一次只动一个）
# ══════════════════════════════════════════════════════════
#
#   蓄得太慢/太快 .... student.gd 的 满蓄力时长（现在 0.8 秒）
#   嫌扔得近 ....... student.gd 的 最轻档身位（现在 4；每档差 1 身位是公式定死的）
#   弧度太飘/太平 .. 组件的 出手角（现在 45°；越高越飘、越低越平）
#   飞行快慢 ....... 组件的 重力（现在 900）
#
# 【注意】组件的 重力 900 只管「飞行这段弧线」；箱子站着往下掉的重力是
# 箱子自己 _ready 里灌给组件的（跟它下落用同一个数）。学生的飞行重力
# 目前没显式设、用的是组件默认值 —— 两个数现在碰巧相等，
# 以后想分开调（比如人飞得更飘、箱子飞得更砸）记得各设各的。
