extends RefCounted
## ============================================================
## 参考答案 · 状态机（把「一坨 if」拆成「一个行为一个文件」）
## ------------------------------------------------------------
## 这份不参与游戏运行，是给你看的。正式版拆成两个文件：
##   组件/状态机/状态机.gd   只管「这一帧该跑哪个状态」
##   组件/状态机/状态.gd     状态的基类（进入 / 每帧 / 离开）
## 学生的七个状态在 角色/学生/状态/ 下，一个状态一个脚本。
##
## 想看「谁跟谁说话」「怎么加一个新行为」，看这一份就够了。
## ============================================================


# ============================================================
# 第一段：为什么要有状态机
# ------------------------------------------------------------
# 拆之前，student.gd 有 700 多行，_physics_process 里塞着七段「早退分支」：
#   被扛着？→ 干脆什么都不做，return
#   瘫了？→ 蹲着，return
#   被钉在锁口前？→ 站着别动，return
#   ……一路问到底，谁在谁前面只藏在代码行的先后顺序里。
#
# 问题不是代码长，是**读不出来优先级**：
#   想知道「瘫痪和被拎谁说了算」，得把七段全读完再自己排。
# 状态机把「现在该是谁」变成一帧一问的**一张表**，把「每个状态下干什么」
# 各自搬进**自己的文件**。改攀爬只开攀爬.gd，别的文件一个字不用碰。
# ============================================================


# ============================================================
# 第二段：状态机本体 —— 它只管「该跑谁」，不管跑的内容
# ------------------------------------------------------------
# 它没有一个 if 在判断游戏规则，所以学生能用、宿管将来也能用同一份。
# ============================================================

# 一帧内最多连切几次（防两个状态互相踢皮球，把一帧卡死）
const 最大连切 := 4

var host                # 它属于谁（学生 / 将来的宿管）
var _状态表 := {}       # 状态名 -> 状态对象
var _当前: String = ""  # 现在跑的是谁


## 注册一个状态。必须在启动()之前把要用的都注册完
func 加(名字: String, 状态对象) -> void:
	状态对象.host = host        # 顺手把 host 灌给它，状态脚本不用自己拿
	_状态表[名字] = 状态对象


## 开局直接进入某状态，只跑「进入」
func 启动(名字: String) -> void:
	_当前 = 名字
	_状态表[_当前].进入("")


## 现在在哪个状态。调试面板看数用。
## 【不许拿它写游戏规则】——「现在是攀爬就怎样」这种判断写进状态里，
## 写在外面就又变回 if 链了
func 当前() -> String:
	return _当前


## 硬切：切过去后，本物理帧到此为止（绝大多数地方用这个）
func 切(名字: String) -> void:
	_真正切(名字)

## 软切：切过去后本帧继续跑新状态（正式版里有，本工程目前没用到）
func 软切(名字: String) -> void:
	_真正切(名字)


## 每物理帧由角色调一次，永远只有两步：
##   ① 先问角色「该不该抢」→ 该抢就切，本帧结束
##   ② 没被抢 → 跑当前状态的行为
func 跑(delta: float) -> void:
	for _i in 最大连切:            # 一帧内最多连切几次，防两个状态互相踢皮球
		var 现在 := _当前
		# ① 抢占：角色按优先级回答「现在该在哪个状态」
		var 抢: String = host.抢占(现在)
		if 抢 != "" and 抢 != 现在:
			切(抢)
			return
		# ② 跑当前状态自己的行为（代码在 攀爬.gd / 正常.gd …… 里）
		_状态表[现在].每帧(delta)
		return


## 真正切换：先让旧状态「离开」，再让新状态「进入」。
## 同名 → 什么都不做（「已经在做这件事」就靠这句跳过）
func _真正切(名字: String) -> void:
	if 名字 == _当前:
		return
	var 旧 := _当前
	_状态表[旧].离开(名字)
	_当前 = 名字
	_状态表[_当前].进入(旧)


# ============================================================
# 第三段：抢占 —— 优先级是一张能读的表，不是代码行的先后
# ------------------------------------------------------------
# 这张表在 student.gd 里（不在状态机里！）。
# 行序 = 优先级，想调先后只挪行，不用去重读七百行：
#
#   被扛着或在飞 → 被拎  位置由别人摆（扛着），或正被扔在空中（抛投组件推进）
#   瘫了     → 瘫痪     两格血打空，蹲地
#   被钉住   → 插钥匙中 锁孔前那几秒
#   被切走   → 旁观     玩家把控制权给了别人（F1 换人）
#   正在救人 → 救人中   继续救，松手由救人的状态自己收尾再切走
#   扒着梯子 → 攀爬     上下键有一个按着
#   以上都不是 → 正常   走路、跳跃、交互，全在这
#
# 【注意】「抢占」只回答「该在哪个状态」，不回答「在那个状态里干什么」——
#   后者写在各自状态的 每帧() 里。两边写混了，拆状态机就白拆了。
# ============================================================


# ============================================================
