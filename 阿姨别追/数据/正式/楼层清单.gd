extends RefCounted
## 楼层清单 · **正式版**（当前一局：主场景2，四层薄地板那张手绘图）—— 2026-11-06
##
## 【放在 数据/正式/ 是什么意思】
##   这里是**正式地图**的坐标表 —— `project.godot` 的 `run/main_scene` 跑的那一局用它。
##   测试/自测当布景的旧一张图在 `数据/测试/楼层清单_旧一楼.gd`，两边各改各的，互不影响。
##   规矩：`数据/` 根目录只放**规则**（通用规则、重量档位）；坐标表按用途分进
##   `数据/正式/` 和 `数据/测试/` 两个文件夹。
##
## 【这张表只管这张图的坐标】
##   换地形就得换表；表里只写「什么东西摆在哪」，**一条规则都不写**。
##   规则（默认开门用时、钥匙板配色、钥匙板编号）在 `数据/通用规则.gd`，
##   那份**对所有地图生效**，由楼层代理直接去读 —— 本文件不转发、不复制。
##   （11-06 之前这里用 `preload` 去借一楼那张表的规则，等于让四层全挂在一张
##    地图表上；那张表后来移进了 `数据/测试/`。已拆掉，现在不依赖任何别的表。）
##
## 【坐标怎么来的】
##   对着 场景/主场景2.tscn 的图块算出来的（一格 16 像素，tile 的**上表面**就是地面线）：
##     四楼 顶面 -80 / -64 / -48（三段台阶）
##     三楼 顶面 112 / 128 / 144 / 160
##     二楼 顶面 272 / 288
##     一楼 顶面 432 / 448 / 464
##   所以同一层里 y 不一样是正常的 —— 那是台阶，不是错。
##
## 【层带】每层在竖直方向占哪一段，pipeline 判层用（Vector2(上界 y, 下界 y)）
##   取的是「本层最高面」和「下一层最高面」的中点：
##     四楼 -80 ─┐ 中点 16
##     三楼 112 ─┤ 中点 200
##     二楼 272 ─┤ 中点 360
##     一楼 432 ─┘ （往下不再有层）
##   改地图以后这两个数要跟着改，但**代码不用动** —— 这就是把数字放数据里的意思。

const 楼层 := {
	# ── 四楼（最高）─────────────────────────────────────────
	"四楼": {
		"层带": Vector2(-160.0, 16.0),

		# 检修口：盖在地板缺口上的单向平台，按 S 放开就掉到三楼。
		# 位置 = Vector2(中心 x, 地面 y)。宽度默认 32（两格），够一个人（宽 20）落下去。
		# 【最底层没有检修口】一楼不写这一段 = 掉不出虚空。
		"检修口": [
			{ "编号": "4-检修口", "位置": Vector2(480, -64), "宽": 32.0 },
			# 梯子洞也盖一块。爬梯上来的人爬到判定框顶端会脱钩，脚正好悬在洞中央 ——
			# 洞上没东西接着，他就原路掉回下面那层（实测：一楼上到 225，然后掉回 464）。
			# 单向平台从下往上能穿过去，所以爬梯不撞头；爬到头正好踩在这块板上站住。
			{ "编号": "4-梯子口", "位置": Vector2(-640, -80), "宽": 32.0 },
		],

		# 三号钥匙板（黑铁）放在四楼最右端，逼玩家爬上来一趟
		"钥匙板": [
			{ "编号": "三号", "位置": Vector2(1288, -88) },
		],
	},

	# ── 三楼 ────────────────────────────────────────────────
	"三楼": {
		"层带": Vector2(16.0, 200.0),

		"检修口": [
			{ "编号": "3-检修口", "位置": Vector2(-320, 128), "宽": 32.0 },
			{ "编号": "3-梯子口", "位置": Vector2(720, 144), "宽": 32.0 },
		],

		# 二号钥匙板（白铁）在三楼最左端
		"钥匙板": [
			{ "编号": "二号", "位置": Vector2(-792, 72) },
		],

		# 一个可用道具，验证「扛着东西还能不能按 S 下楼」
		# （不是新玩法，就是原来那个捡了没效果的占位道具）
	},

	# ── 二楼 ────────────────────────────────────────────────
	"二楼": {
		"层带": Vector2(200.0, 360.0),

		"检修口": [
			{ "编号": "2-检修口", "位置": Vector2(160, 288), "宽": 32.0 },
			{ "编号": "2-梯子口", "位置": Vector2(1120, 288), "宽": 32.0 },
		],

		# 一号钥匙板（黄铜）在二楼左端
		"钥匙板": [
			{ "编号": "一号", "位置": Vector2(-712, 248) },
		],
	},

	# ── 一楼（最底层，没有检修口 = 掉不出虚空）────────────────
	"一楼": {
		"层带": Vector2(360.0, 600.0),

		"门": [
			{ "编号": "1-走廊东", "位置": Vector2(968, 464) },
			{ "编号": "1-走廊西", "位置": Vector2(-472, 432) },
		],

		"锁口": [
			{
				"编号": "1-门厅",
				"位置": Vector2(968, 464),
				"插孔用时": 2.0,
				"连哪扇门": "1-走廊东",
			},
		],

		"出口": [
			{
				"编号": "1-门厅出口",
				"位置": Vector2(968, 464),
				"等的门": "1-走廊东",
				"站多久": 1.0,
			},
		],
	},
}
