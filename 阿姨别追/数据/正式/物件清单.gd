extends RefCounted
## 物件清单 · **正式版**（当前一局：主场景2，四层薄地板那张手绘图）
##
## 【这张表是什么】
##   一张**平表**：键 = 编号，值 = 这件东西是什么（"类型"）、摆在哪。
##   按编号认件，见技术框架 §4.2。
##
## 【编号怎么起】<层号>-<名字>，例：1-走廊东 / 4-检修口。
##   层号只是**给人看的前缀**，代码从来不解析它。把 4-检修口 搬到二楼，
##   改个名字就行，逻辑一个字不用动。
##   ⚠️ 唯一硬规矩：**全工程不能重号**。重了总管会警告，后来的顶掉前面的。
##   ⚠️ 改名要连引用一起改：锁口的「连哪扇门」、出口的「等的门」写的都是编号。
##
## 【位置怎么填】Vector2(x, y)，y 是「贴地那条线」：
##   门 / 锁口 / 出口 = 底部贴地；检修口 = 盖板**上表面**（就是地面线）；
##   钥匙板 = 板子**中心**，且 y 要比地面高至少 20 像素（它会自己落地）。
##
## 【坐标怎么来的】对着 场景/主场景2.tscn 的图块算出来的（一格 16 像素）：
##     四楼 顶面 -80 / -64 / -48（三段台阶）
##     三楼 顶面 112 / 128 / 144 / 160
##     二楼 顶面 272 / 288
##     一楼 顶面 432 / 448 / 464
##   同一层里 y 不一样是正常的 —— 那是台阶，不是错。
##
## 【这里一条规则都不写】开门用时、钥匙板配色/编号在 `数据/通用规则.gd`，
##   对所有地图生效。本文件只回答「什么东西摆在哪个坐标」。

const 物件 := {

	# ── 四楼 ────────────────────────────────────────────────
	"4-检修口": {
		"类型": "检修口",
		"位置": Vector2(480, -64),
		"宽": 32.0,
	},
	# 梯子洞也盖一块：爬梯到顶端脱钩时脚悬在洞中央，没这块板接着就原路掉回下层。
	# 单向平台从下往上能穿过去，所以爬梯不撞头，爬到头正好踩在这块板上站住。
	"4-梯子口": {
		"类型": "检修口",
		"位置": Vector2(-640, -80),
		"宽": 32.0,
	},
	# 三号钥匙板（黑铁）放在四楼最右端
	"三号": {
		"类型": "钥匙板",
		"位置": Vector2(1288, -88),
	},

	# ── 三楼 ────────────────────────────────────────────────
	"3-检修口": {
		"类型": "检修口",
		"位置": Vector2(-320, 128),
		"宽": 32.0,
	},
	"3-梯子口": {
		"类型": "检修口",
		"位置": Vector2(720, 144),
		"宽": 32.0,
	},
	# 二号钥匙板（白铁）在三楼最左端
	"二号": {
		"类型": "钥匙板",
		"位置": Vector2(-792, 72),
	},

	# ── 二楼 ────────────────────────────────────────────────
	"2-检修口": {
		"类型": "检修口",
		"位置": Vector2(160, 288),
		"宽": 32.0,
	},
	"2-梯子口": {
		"类型": "检修口",
		"位置": Vector2(1120, 288),
		"宽": 32.0,
	},
	# 一号钥匙板（黄铜）在二楼左端
	"一号": {
		"类型": "钥匙板",
		"位置": Vector2(-712, 248),
	},

	# ── 一楼（最底层，没有检修口 = 掉不出虚空）────────────────
	"1-走廊东": {
		"类型": "门",
		"位置": Vector2(968, 464),
		# 想给这一扇门单独配开门时长，就在这里加：
		#   "开门用时": { "求生者": 3.0, "宿管": 3.0 }
		# 没写的角色继续用 `通用规则.gd` 的默认值。
	},
	"1-走廊西": {
		"类型": "门",
		"位置": Vector2(-472, 432),
	},
	# 门上那排锁孔，全楼只有这一个
	"1-门厅": {
		"类型": "锁口",
		"位置": Vector2(968, 464),
		"插孔用时": 2.0,
		"连哪扇门": "1-走廊东",
	},
	# 门口判定区：门被真正解锁之后，站够「站多久」秒就算逃出去
	"1-门厅出口": {
		"类型": "出口",
		"位置": Vector2(968, 464),
		"等的门": "1-走廊东",
		"站多久": 1.0,
		# 门外在哪个方向：+1 = 右（+x）/ -1 = 左。只有门外侧才计时
		"出门方向": 1,
	},
}
