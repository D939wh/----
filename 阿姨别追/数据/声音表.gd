extends RefCounted
## 声音表 —— 全项目「一个动作有多响」的唯一真相。
##
## 主人 2026-11-09 20:23 定：**先按档次做，四档**。
## 同一个声音在地图的不同位置听到的音量不一样（越远越小），
## 所以每档只给一个「传播半径」，音量由距离现算 —— 别在别处再写一套衰减。
##
##   1 档 很轻 —— 按住 Shift 慢走
##   2 档 较大 —— 正常跑动
##   3 档 很大 —— 把手上的东西丢下来
##   4 档 极大 —— 开关门；最后的合闸（逃出读条）
##
## 100 px = 1 米（和策划案、站位距离用同一套换算）。

const 档_很轻 := 1
const 档_较大 := 2
const 档_很大 := 3
const 档_极大 := 4

const 米: float = 100.0

## 每档能传多远（像素）。想整体放大 / 缩小听觉，只改这四行。
const 半径表 := {
	档_很轻: 2.0 * 米,     # 200：贴脸慢走才会被听见
	档_较大: 4.0 * 米,     # 400：跑起来比视觉察觉圈（360）还远一点
	档_很大: 6.0 * 米,     # 600：丢下箱子，半层楼都听得见
	档_极大: 9.0 * 米,     # 900：开关门 / 合闸，和宿管视野同一个量级
}

## 来源：只用来打日志、将来区分对待（比如门声优先），不参与「听不听得见」。
const 来源_脚步 := 0
const 来源_跑动 := 1
const 来源_丢物 := 2
const 来源_门 := 3
const 来源_合闸 := 4

const 来源名 := {
	来源_脚步: "脚步",
	来源_跑动: "跑动",
	来源_丢物: "丢东西",
	来源_门: "门",
	来源_合闸: "合闸",
}

## 低到这个音量以下就当没听见。0.15 = 要进半径内侧 85% 才作数，
## 免得站在圈边上被一声脚步惊动。
const 最低反应音量: float = 0.15

## 宿管把一声响记多久（秒）。太短：走到一半就忘了；太长：旧声音一直压着新巡逻。
const 记忆时长: float = 6.0


## 这一档能传多远。
static func 半径(档: int) -> float:
	return float(半径表.get(档, 半径表[档_较大]))


## 站在 `距离` 处的人听到多大声：0 = 完全没声，1 = 就在耳边。
## 线性衰减（够用、好读）：距离 0 → 1.0，正好到半径 → 0.0。
static func 音量(距离: float, 半径值: float) -> float:
	if 半径值 <= 0.0:
		return 0.0
	return clampf(1.0 - 距离 / 半径值, 0.0, 1.0)


static func 来源文字(来源: int) -> String:
	return String(来源名.get(来源, "?"))
