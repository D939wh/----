## 按公斤取档号："1" / "2" / "3" / "4"
## （返回纯数字，是为了让别的脚本好判断；给人看的时候自己加「档」字）
static func 档名(公斤: float) -> String:
	for 名 in ["1", "2", "3"]:
		if 公斤 <= float(表[名]["上限"]):
			return 名
	return "4"


## 按公斤取整档数据
static func 取(公斤: float) -> Dictionary:
	return 表[档名(公斤)]


## 给界面看的档位叫法："1 档" / "2 档" / "3 档" / "4 档"
static func 档位全名(公斤: float) -> String:
	return 档名(公斤) + " 档"


## 空手时用的「虚拟档」：全部 1 倍，什么都不限制。
## 有了它，学生脚本里就不用到处写「有没有扛东西」的 if —— 空手 = 扛 0 公斤
static func 空手() -> Dictionary:
	return {
		"档号": 0,
		"上限": 0.0,
		"移速倍率": 1.00,
		"可否慢走": true,
		"跳跃高度倍率": 1.00,
		"可否攀爬": true,
		"拖行": false,
		"说明": "空手",
	}
