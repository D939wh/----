extends RefCounted
## ── 四档重量（策划案 §3.2）──────────────────────────────────
##
## 这张表是**唯一真源**：扛起来之后走得快不快、能不能跳、能不能爬梯，
## 全看这里。学生脚本只负责「照表执行」，一行数字都不写死。
## 想调手感，改这里的数字就够了，别去改 student.gd。
##
## 单位：公斤（.tscn 里每件可搬运物自己的「重量」属性）

const 表 := {
	"轻": {
		"上限": 20.0,
		"移速倍率": 0.90,
		"可否慢走": true,
		"跳跃高度倍率": 1.00,
		"可否攀爬": true,
		"拖行": false,
		"说明": "红牛、手电筒：只慢一点点，其他照常",
	},
	"中": {
		"上限": 40.0,
		"移速倍率": 0.60,
		"可否慢走": false,
		"跳跃高度倍率": 0.50,
		"可否攀爬": false,
		"拖行": false,
		"说明": "钥匙板、撬棍：禁慢走、只能跳一半高、爬不了梯",
	},
	"重": {
		"上限": 70.0,
		"移速倍率": 0.45,
		"可否慢走": false,
		"跳跃高度倍率": 0.00,
		"可否攀爬": false,
		"拖行": true,
		"说明": "蹲地的队友：不能跳、不能爬，只能拖",
	},
	"超重": {
		"上限": 99999.0,
		"移速倍率": 0.30,
		"可否慢走": false,
		"跳跃高度倍率": 0.00,
		"可否攀爬": false,
		"拖行": true,
		"说明": "纸箱、床板：只能横向拖行，蹭地很响",
	},
}


## 按公斤取档名："轻" / "中" / "重" / "超重"
static func 档名(公斤: float) -> String:
	for 名 in ["轻", "中", "重"]:
		if 公斤 <= float(表[名]["上限"]):
			return 名
	return "超重"


## 按公斤取整档数据
static func 取(公斤: float) -> Dictionary:
	return 表[档名(公斤)]


## 空手时用的「虚拟档」：全部 1 倍，什么都不限制。
## 有了它，学生脚本里就不用到处写「有没有扛东西」的 if —— 空手 = 扛 0 公斤
static func 空手() -> Dictionary:
	return {
		"上限": 0.0,
		"移速倍率": 1.00,
		"可否慢走": true,
		"跳跃高度倍率": 1.00,
		"可否攀爬": true,
		"拖行": false,
		"说明": "空手",
	}
