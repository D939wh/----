extends RefCounted
## 楼层清单 —— 你文档里说的「记录与玩家互动」的那张表
##
## 这不是代码，是数据。要加一扇门、挪一盏灯，只改这里，不用碰任何脚本。
## 改完存盘，F5 就生效。
##
## 位置怎么填：Vector2(x, y)
##   x = 门中心的横向位置（像素，往右变大）
##   y = 门底部贴地的那条线（像素，往下变大）。学生站着的脚底高度就是它。
##
## 现在学生站在 (879, 178)，所以门放在 x=760、y=178，就在他左手边。
## 想挪门，就把 760 改大或改小。
##
## 【开门用时为什么在这张表里】（2026-11-04 主人定）
##   开门是「场景里发生的事」，不是「角色身上的属性」。
##   角色只会对门说一句「我要推你」，门自己决定多快 —— 学生 0.3 秒、宿管 1.5 秒。
##   所以这两个数字属于场景（这扇门），不属于人。
##   好处：以后想做一扇「谁都得推 3 秒」的防火门，只在这一行加一句话，
##        学生和宿管的脚本一个字都不用改。

## 全楼默认：清单里没给某扇门单独配的时候，用这一份
const 默认开门用时 := { "求生者": 0.3, "宿管": 1.5 }

const 楼层 := {
	"一楼": {
		"门": [
			# 想给某一扇门单独配时长，就在这条里加 "开门用时"，比如：
			#   { "编号": "1-走廊东", "位置": Vector2(760, 178), "开门用时": { "求生者": 0.8 } }
			# 只写了谁，谁就变；没写的那个继续用上面的默认（宿管仍是 1.5 秒）。
			{ "编号": "1-走廊东", "位置": Vector2(760, 178) },
			{ "编号": "1-走廊西", "位置": Vector2(620, 178) },
		],
	},
}


## 给楼层代理用：算出这扇门实际的开门用时（默认 + 这扇门自己的覆盖）
static func 开门用时(门条目: Dictionary) -> Dictionary:
	var 表 := 默认开门用时.duplicate()
	var 覆盖: Dictionary = 门条目.get("开门用时", {})
	表.merge(覆盖, true)
	return 表
