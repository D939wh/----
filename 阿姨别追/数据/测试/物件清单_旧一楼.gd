extends RefCounted
## 物件清单 · **测试用**（旧一楼图 `场景/主场景.tscn`）—— 只给自测当布景
## 正式那一局（`场景/主场景2.tscn`）用 `数据/正式/物件清单.gd`。**改正式手感别改这个文件。**
##
## 【格式和正式版完全一样】一张平表：键 = 编号，值里写「类型」和坐标。
##   加一扇门 = 加一行；挪一块板 = 改两个数字；不用碰任何脚本。
##
## 【位置怎么填】Vector2(x, y)，y 是「贴地那条线」：
##   门 / 锁口 / 出口 = 底部贴地；钥匙板 = 板子中心，且比地面高至少 20 像素
##   （它落地靠往下打短射线，出生点在地面以下就会一路掉出屏幕）。

const 物件 := {

	# 一扇门。想单独配时长就加 "开门用时"，没写的角色继续用通用规则的默认值。
	# "空气墙" = 看不见门板、E 推不动，只能被三块钥匙板真正解锁弹开（这张图的大门）
	"1-走廊东": {
		"类型": "门",
		"位置": Vector2(760, 178),
		"空气墙": true,
	},
	"1-走廊西": {
		"类型": "门",
		"位置": Vector2(620, 178),
	},

	# 三块钥匙板。位置 = 板子**中心**的坐标（它会自己落到地上）
	"一号": {
		"类型": "钥匙板",
		"位置": Vector2(320, 120),
	},
	"二号": {
		"类型": "钥匙板",
		"位置": Vector2(540, 120),
	},
	"三号": {
		"类型": "钥匙板",
		"位置": Vector2(1400, 120),
	},

	# 门上那排锁孔。全楼只有这一个
	#   插孔用时：按住 R 要几秒插进去。填 0.1 基本等于按一下就进。
	#   连哪扇门：三个孔插满时开这扇门，名字要对得上上面的编号。
	"1-门厅": {
		"类型": "锁口",
		# 位置 = 锁板**底边**贴地那条线。这条走廊地面在 y=208
		"位置": Vector2(760, 208),
		"插孔用时": 2.0,
		"连哪扇门": "1-走廊东",
	},

	# 门口判定区：解锁后求生者一碰到就算赢。摆哪、多大这张图自己定，代码不挪它：
	#   "判定区偏移" = 判定框中心相对出口锚点挪多少（y 负 = 往上），不写就贴着锚点；
	#   "判定区大小" = Vector2(宽, 高)，不写就沿用出口场景里那一块（120×96）
	"1-门厅出口": {
		"类型": "出口",
		"位置": Vector2(760, 208),
		"等的门": "1-走廊东",
		# 判定框挪到门线右外侧：+60 往右（大门在 760），-48 是常规高度
		"判定区偏移": Vector2(60, -48),
	},

	# 第二个出口（验「一张图可以不止一个出口」）：等西门。
	# 西门从没被真正解锁，它就全程不激活
	"1-西走廊出口": {
		"类型": "出口",
		"位置": Vector2(620, 178),
		"等的门": "1-走廊西",
		"判定区偏移": Vector2(-60, -48),
	},
}
