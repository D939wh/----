extends RefCounted
## 楼层清单 · **测试用**（旧一楼图 `场景/主场景.tscn`）—— 只给自测当布景
##
## 【为什么在 数据/测试/】
##   这张表配的是旧一楼图，正式那一局（`场景/主场景2.tscn`）已经不用它了。
##   留着是因为 6 个自测（三层交互 / 阿姨打人 / 点击切换 / 钥匙锁口 /
##   射线诊断 / 切人卡死诊断）拿旧图当布景，坐标全写死在这张表里。
##   正式版的坐标表是 `数据/正式/楼层清单.gd` —— **改正式手感别改这个文件**。
##
## 这不是代码，是数据。要加一扇门、挪一盏灯，只改这里，不用碰任何脚本。
## 改完存盘，F5 就生效。
##
## 【这里只放坐标，规则不放这里】（2026-11-06 改）
##   原来「默认开门用时 / 钥匙板配色 / 钥匙板编号」写在本文件里，结果是：
##   第二张地图得 `preload` 这张地图的表去借规则 —— 规则被绑死在一张图上。
##   现在规则统一在 `数据/通用规则.gd`，**对所有地图生效**；
##   本文件只回答「一楼这扇门/这块板在哪个坐标」。
##   正式地图照 `数据/正式/楼层清单.gd` 那样写坐标就行，不用管规则。
##
## 位置怎么填：Vector2(x, y)
##   x = 门中心的横向位置（像素，往右变大）
##   y = 门底部贴地的那条线（像素，往下变大）。学生站着的脚底高度就是它。
##
## 现在学生站在 (879, 178)，所以门放在 x=760、y=178，就在他左手边。
## 想挪门，就把 760 改大或改小。
##
## 【某扇门想特殊怎么办】
##   在那一行加 "开门用时"，只覆盖这扇门；没写的角色继续用 `通用规则.gd` 的默认。
##   例：{ "编号": "1-防火门", "位置": Vector2(760, 178), "开门用时": { "求生者": 3.0 } }

const 楼层 := {
	"一楼": {
		"门": [
			# 想给某一扇门单独配时长，就在这条里加 "开门用时"，比如：
			#   { "编号": "1-走廊东", "位置": Vector2(760, 178), "开门用时": { "求生者": 0.8 } }
			# 只写了谁，谁就变；没写的那个继续用上面的默认（宿管仍是 1.5 秒）。
			{ "编号": "1-走廊东", "位置": Vector2(760, 178) },
			{ "编号": "1-走廊西", "位置": Vector2(620, 178) },
		],

		# 三块钥匙板摆在哪。加一块、挪一块，只改这里。
		# 位置 = 这块板子**中心**的坐标（它会自己落到地上）
		# ⚠️ y 一定要填得比地面**高出一截**（至少 20 像素）。为什么：
		#    它落地靠的是"从自己身上往下打一条短射线"，出生点要是已经在地面以下，
		#    射线从地下往更深处探，永远探不到地面，板子会一路掉出屏幕。
		#    11-05 就踩过：填 200 而那块地面在 208，三号板直接掉没了。
		"钥匙板": [
			{ "编号": "一号", "位置": Vector2(320, 120) },
			{ "编号": "二号", "位置": Vector2(540, 120) },
			{ "编号": "三号", "位置": Vector2(1400, 120) },
		],

		# 门上那排锁孔。全楼只有这一个（策划案 v0.5：唯一楼门）
		#   插孔用时：按住 R 要几秒插进去。策划案 v0.5 写 0.6 秒、不做读条；
		#            主人 11-05 说「照猫和老鼠搬奶酪那套」，那边是 2~8 秒，先取 2 秒。
		#            **改这一个数就能两种都试**：填 0.1 基本等于按一下就进。
		#   连哪扇门：三个孔插满时，开这扇门。名字要对得上上面「门」里的编号。
		"锁口": [
			{
				"编号": "1-门厅",
				# 位置 = 锁板**底边**贴地的那条线。11-05 实测：这条走廊的地面在 y=208
				# （探针把学生从高处扔下去，落在 208）。原来跟着门填 178，结果锁板悬空 30 像素 ——
				# 门板高 96 看不出来，锁板矮就一眼看出飘着。
				"位置": Vector2(760, 208),
				"插孔用时": 2.0,
				"连哪扇门": "1-走廊东",
			},
		],

		# 门口判定区：等的门开了之后，站够「站多久」秒就算逃出去
		# 【为什么"等的门"要写名字】出口不认识门，只认名字。
		#   门不管是因为什么开的（人推开、三个孔插满弹开），只要开了这里就开始算。
		"出口": [
			{
				"编号": "1-门厅出口",
				"位置": Vector2(760, 208),
				"等的门": "1-走廊东",
				"站多久": 1.0,
			},
		],
	},
}
