extends Node2D
## 检修口 —— 楼板上一个缺口，上面盖着一块单向平台
##
## 【它现在只干一件事：按清单把自己摆到位置上】
##   踩得住、按 S 能穿下去，全部由引擎负责，一行开关代码都没有：
##     · 盖板在物理第 2 层「可以穿过的地板」，CollisionShape2D 勾着 One Way；
##     · 按 S 时**学生自己**把第 2 层从掩码里摘掉 0.4 秒（见 `student.gd`）。
##
## 【2026-11-06 删掉的东西，别再写回来】
##   第一版这里是「取厚度 / 可下穿 / 能接住 / 开 / _process 计时」，
##   再由学生按 S 把第 5 层从自己掩码里摘掉。
##   能跑，但每加一块板都得重新挂一遍脚本、还得记住它多厚 ——
##   主人当场指出这太麻烦。业内的做法是**意图在编辑期标注，运行期只读标注**：
##   板属于第几层，就是它「能不能穿」的全部意思，不需要运行时再猜。
##
## 【为什么连「我多厚」都不留】
##   厚度是碰撞形状的几何尺寸，不是「能不能穿」的依据。两件事混在一个数上，
##   以后有人把板加厚 2 像素，行为就莫名其妙变了 —— 那种 bug 最难查。
##
## 【这个文件里没有一行画东西】
##   没有 Sprite2D、没有 Polygon2D、没有 ColorRect。检修口长什么样是美术的事，
##   要画就在场景里另外挂一个绘制节点（渲染层），不许长在这里 ——
##   框架 §6.6：光照与可见性不进组件。物理组件里长出美术，
##   以后换贴图得改物理脚本，调厚度会碰到画出来的东西，两件事永远分不开。
##
## 【物理层】盖板占第 2 层「可以穿过的地板」，层号登记在 `数据/通用规则.gd`。
##   单独占一层是为了「只放开它」：墙和楼板在第 1 层，摘层时它们纹丝不动。

## 全局规则。层号从那里取，这里不许写死 5 或 16
const 规则 := preload("res://数据/通用规则.gd")

## 盖板的碰撞形状厚度（像素）。**只是几何尺寸，不决定能不能穿。**
## 上表面压在节点原点（清单里的 y 填的就是「地面那条线」）。
const 盖板厚度: float = 6.0

## 半宽（像素）。由 setup 按清单给的宽度算
var 半宽: float = 16.0

## 这个检修口的身份证（"4-检修口" 这种）。由物件代理照清单盖章，或在检查器里手填。
## 【它不参与按键】按 S 是学生自己摘物理层，跟这里无关；
##   留编号是为了「图上这块板是哪块」查得出来（总管那本账里能按号找）。
## 身份证（编号）。**必须用英文名导出** —— 中文名的导出属性在 `.tscn` 里赋值会
## **静默失效**（2026-11-06 实测：`.tscn` 里明明写着 `编号 = "1-箱子"`，运行时读出来是空串，
## 属性表里那一项也在，就是不生效）。所以编辑器里填 `thing_id`，代码里读 `编号`。
@export var thing_id: String = ""

## 中文别名：全工程代码统一用「编号」读写，和 `thing_id` 是同一个值
var 编号: String:
	get:
		return thing_id
	set(值):
		thing_id = 值


func _ready() -> void:
	Director.register_thing(编号, self)


## 由物件代理照清单调用：中心 x、地面 y（= 盖板**上表面**的 y）、宽度
func setup(中心x: float, 地面y: float, 宽: float) -> void:
	position = Vector2(中心x, 地面y)
	name = "检修口_%d_%d" % [int(中心x), int(地面y)]
	半宽 = 宽 * 0.5
	_改宽度(宽)


## 换宽度：形状重新造一个（RectangleShape2D 是共享资源，直接改 size 会波及别的口）
##
## 顺便把「属于哪一层、是不是单向」在这里落死一次：就算有人手滑改坏了 .tscn，
## 代理一摆出来也会被纠正回第 2 层 + 单向。层号来自规则，全工程只有一个数。
func _改宽度(宽: float) -> void:
	var 形 := RectangleShape2D.new()
	形.size = Vector2(宽, 盖板厚度)

	var 节点 := get_node_or_null("平台/CollisionShape2D") as CollisionShape2D
	if 节点 != null:
		# 形状中心压在 (0, +盖板厚度/2)，让**上表面**正好落在节点原点上 ——
		# 这样清单里的 y 填的就是「地面那条线」，和门、锁口的填法一致。
		节点.position = Vector2(0.0, 盖板厚度 * 0.5)
		# 单向：从下往上能穿过去（爬梯子不会撞头），从上往下踩得住
		节点.one_way_collision = true

	var 平台 := get_node_or_null("平台") as StaticBody2D
	if 平台 != null:
		平台.collision_layer = 规则.层_可穿过地板
		平台.collision_mask = 0
