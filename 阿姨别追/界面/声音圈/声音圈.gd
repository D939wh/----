extends Control
## ============================================================
# 声音圈 —— 屏幕正中央的「耳朵」。
# ------------------------------------------------------------
# 当前控制角色听得到的每一声响，在环上朝声源方向泛起一道弧光：
# 左边的声在左、楼上的声在上，越响弧越宽越亮。学生玩家和宿管玩家
# 都靠它在屏幕上「看到」对方的动静位置。
#
# 【只管显示，不参与判断】
# 「听不听得见」和宿管 AI 同一套标准：音量 = 声音表.音量(听者→声源距离, 半径)，
# 低于 声音表.最低反应音量 不显示。本文件不写第二份衰减公式或阈值 ——
# 改声音表，这里自动跟。
#
# 【钉死在视口正中】
# 本节点住在场景自带的 CanvasLayer 里，不受相机影响；
# 视口 stretch 是 viewport 模式，逻辑分辨率固定 640×360。
#
# 【怎么用】把 声音圈.tscn 实例挂进场景即可（主场景2 已挂）。
# 听者 = Director.当前控制：F1 换人后，下一道波自动跟新听者算；
# 已经画出来的波不追着重算 —— 波生成那刻的方向和音量就定死了。
## ============================================================

const 声音表 := preload("res://数据/声音表.gd")

# —— 画法参数：全在这一处，别去别处找第二份 ——
const 环半径: float = 70.0             # 底环多大（屏幕像素）
const 底环粗: float = 1.0               # 细线低调：常驻但不抢画面
const 底环色 := Color(0.85, 0.83, 0.75, 0.16)
const 波色 := Color(1.0, 0.88, 0.52)    # 淡暖黄做强调色
const 弧宽最窄: float = 0.35            # 弧度：刚过阈值的轻响
const 弧宽最宽: float = 1.7              # 弧度：贴脸巨响
const 亮度下限: float = 0.22
const 亮度上限: float = 1.0
const 线宽下限: float = 2.0
const 线宽上限: float = 5.0
const 波寿命: float = 1.0                # 一道波荡开、淡完用多久（规格 0.8~1.2s，取中）
const 荡开距离: float = 18.0             # 生成后往外扩多远，做「一圈圈荡开」的感觉
const 脚下距离: float = 4.0              # 声源离听者这么近 = 自己弄出的动静，不显示

# —— 可读状态（自测直接读它，不数像素）——
var _波们: Array = []     # 每道波：{方向(弧度), 音量, 剩余(秒)}


func _ready() -> void:
	Events.noise_made.connect(_听见声音)
	resized.connect(queue_redraw)   # 视口尺寸变了，环要重画回正中


func _process(delta: float) -> void:
	# 到寿命的波摘掉；每帧重画（底环常驻，本来就要画）
	for i in range(_波们.size() - 1, -1, -1):
		_波们[i]["剩余"] = float(_波们[i]["剩余"]) - delta
		if float(_波们[i]["剩余"]) <= 0.0:
			_波们.remove_at(i)
	queue_redraw()


## 听到一声：够响就朝声源方向泛一道波。
## 信号是广播的，本节点只当「当前控制角色」这一双耳朵。
func _听见声音(at_position: Vector2, radius: float, _source_id: int) -> void:
	var 听者: Node = Director.当前控制
	if 听者 == null or not is_instance_valid(听者):
		return
	var 耳朵: Vector2 = (听者 as Node2D).global_position
	var 距离: float = 耳朵.distance_to(at_position)
	if 距离 < 脚下距离:
		return   # 自己脚下的动静：方向没意义，只会糊死在圈心
	var 音量: float = 声音表.音量(距离, radius)
	if 音量 < 声音表.最低反应音量:
		return   # 和宿管同一双耳朵：太轻就当没听见
	_波们.append({
		"方向": (at_position - 耳朵).angle(),
		"音量": 音量,
		"剩余": 波寿命,
	})


func _draw() -> void:
	var 中心: Vector2 = size * 0.5
	draw_arc(中心, 环半径, 0.0, TAU, 96, 底环色, 底环粗, true)
	for 波 in _波们:
		var 进度: float = 1.0 - float(波["剩余"]) / 波寿命     # 0 → 1
		var 淡出: float = 1.0 - 进度                            # 1 → 0
		var 音量: float = float(波["音量"])
		var 色 := Color(波色.r, 波色.g, 波色.b, 峰值亮度(音量) * 淡出)
		var 弧宽: float = 弧角宽(音量)
		draw_arc(中心, 环半径 + 进度 * 荡开距离,
			float(波["方向"]) - 弧宽 * 0.5, float(波["方向"]) + 弧宽 * 0.5,
			24, 色, lerpf(线宽下限, 线宽上限, 音量), true)


# ============================================================
# 音量 → 显示强度。单调映射，测试直接调这两个函数断言。
# 归一化从 声音表.最低反应音量 起算：刚过阈值最不显眼，贴脸最显眼。
# ============================================================

func 弧角宽(音量: float) -> float:
	var t := clampf((音量 - 声音表.最低反应音量) / (1.0 - 声音表.最低反应音量), 0.0, 1.0)
	return lerpf(弧宽最窄, 弧宽最宽, t)


func 峰值亮度(音量: float) -> float:
	var t := clampf((音量 - 声音表.最低反应音量) / (1.0 - 声音表.最低反应音量), 0.0, 1.0)
	return lerpf(亮度下限, 亮度上限, t)


# —— 给自测读的状态 ——

func 波数() -> int:
	return _波们.size()


## 波们此刻的样子（复制一份，别让外面改到内部）
func 波快照() -> Array:
	var 出: Array = []
	for 波 in _波们:
		var 音量: float = float(波["音量"])
		出.append({
			"方向": float(波["方向"]),
			"音量": 音量,
			"剩余": float(波["剩余"]),
			"弧宽": 弧角宽(音量),
			"峰值亮度": 峰值亮度(音量),
		})
	return 出


## 底环此刻画在哪（本节点局部坐标，全屏铺开时即屏幕坐标）
func 环中心() -> Vector2:
	return size * 0.5
