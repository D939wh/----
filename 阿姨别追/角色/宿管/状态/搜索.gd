extends "res://组件/状态机/状态.gd"
## 搜索 —— 手里有线索，去那个位置看看。
##
## 【2026-11-13 扩写】线索有两种，**视觉优先于听觉**：
##   · `_视线剩余` > 0：刚才还看得见他，记忆里存着**最后看见的位置** → 奔那儿去（跑着去）
##   · `_听觉剩余` > 0：只听见一声响，只知道坐标 → 按音量慢慢摸 / 快跑
## 这就是「甩掉她」和「被找到」之间那段节奏的来源：你转过墙角，她不是立刻回头巡逻，
## 而是去墙角那头找 3.5 秒。想彻底甩掉，得在这段时间里再拉开距离。
##
## 三条交接规矩：
##   - 半路看见了人 → 交给 `decide()`（眼睛压过一切，变成追击 / 攻击）。
##   - 半路又听见更响的一声 → 直接改道：新坐标由 `_听见声音()` 写进 `_听觉目标`，
##     这里每帧现取，不用另做通知。
##   - 线索过期（两份都到点）→ 回去巡逻。她会忘，这是刻意的：
##     一直惦记一条旧线索，她就永远走不到别的楼道。

const 状态名 := preload("res://角色/宿管/状态/状态名.gd")

## 横向进这个距离就算「到那儿了」（像素）。太小会在坐标点上来回抖。
const 到位判定: float = 16.0
## 到了之后原地张望多久（秒）。这段时间里看见了人就直接追。
const 张望时长: float = 1.8

var _张望了: float = 0.0
var _到了: bool = false


func 进入(_上个: String = "") -> void:
	_张望了 = 0.0
	_到了 = false


func 每帧(delta: float) -> void:
	var h = host

	# 看见了人：眼睛压过一切
	if h._看得见的目标() != null:
		机器().切(h.decide())
		return

	# 两份线索都过期了（或者本来就没有）：撤回去巡逻
	if not h._有记忆():
		机器().切(状态名.巡逻)
		return

	var 靠视觉: bool = h._视线剩余 > 0.0
	var 目标点: Vector2 = h._记忆点()

	# 到地方了：站定张望
	if not _到了 and absf(h.global_position.x - 目标点.x) <= 到位判定:
		_到了 = true

	if _到了:
		h.velocity.x = move_toward(h.velocity.x, 0.0, h.FRICTION * delta)
		if not h.is_on_floor():
			h.velocity.y += h.GRAVITY * delta
		h.move_and_slide()
		_张望了 += delta
		if _张望了 >= 张望时长:
			# 这一趟查完了，把两份线索一起清掉 —— 不然刚转身又被同一件事拉回来
			h._视线剩余 = 0.0
			h._听觉剩余 = 0.0
			h._听觉音量 = 0.0
			# 朝来的方向继续巡逻：别一回头又走进同一面墙
			机器().切(状态名.巡逻)
		return

	# 走过去。**看见过就按追击速度冲过去**（那是一个具体的人，值得跑）；
	# 只是听见过，就按音量插值：轻响慢慢摸过去，巨响直接冲。
	var 速度: float = h.追击速度 if 靠视觉 else lerpf(h.巡逻速度, h.追击速度, h._听觉音量)
	# 线索在楼下（比如一声闷响从下层传上来）→ 允许她跳下去看看
	var 下方: bool = 目标点.y > h.global_position.y + 24.0
	if not h._朝目标走(目标点.x, 速度, delta, 下方):
		_到了 = true    # 真撞墙 / 太深的落差：走不过去，就地看看
