extends "res://组件/状态机/状态.gd"
## 搜索 —— 听见了动静，去那个位置看看。
##
## 她手里只有一个**坐标**和一个**音量**，没有人。所以这个状态只干两件事：
## 走到那个横坐标，站定张望一会儿；看不见人就撤。
##
## 三条交接规矩：
##   - 半路看见了人 → 交给 `decide()`（眼睛压过耳朵，变成追击 / 攻击）。
##   - 半路又听见更响的一声 → 直接改道：新坐标由 `_听见声音()` 写进
##     `_听觉目标`，这里每帧读的就是它，不用另做通知。
##   - 声音过期（`_听觉剩余` 到点）→ 回去巡逻。她会忘，这是刻意的：
##     一直惦记一声旧响，她就永远走不到别的楼道。
##
## **走多快由音量决定**：轻响慢慢摸过去，巨响直接冲。
## 这就是四档在 AI 身上的体现 —— 同一个位置，动静越大她来得越快。

const 状态名 := preload("res://角色/宿管/状态/状态名.gd")

## 横向进这个距离就算「到那儿了」（像素）。太小会在坐标点上来回抖。
const 到位判定: float = 16.0
## 到了之后原地张望多久（秒）。这段时间里看见了人就直接追。
const 张望时长: float = 1.8

var _张望了: float = 0.0
var _到了: bool = false


func 进入(_上个: String = "") -> void:
	_张望了 = 0.0
	_到了 = false


func 每帧(delta: float) -> void:
	var h = host

	# 看见了人：眼睛压过耳朵
	if h._看得见的目标() != null:
		机器().切(h.decide())
		return

	# 那一声已经忘了（或者压根没听见）：撤回去巡逻
	if h._听觉剩余 <= 0.0:
		机器().切(状态名.巡逻)
		return

	# 到地方了（或走不过去）：站定张望
	if not _到了 and absf(h.global_position.x - h._听觉目标.x) <= 到位判定:
		_到了 = true

	if _到了:
		h.velocity.x = move_toward(h.velocity.x, 0.0, h.FRICTION * delta)
		if not h.is_on_floor():
			h.velocity.y += h.GRAVITY * delta
		h.move_and_slide()
		_张望了 += delta
		if _张望了 >= 张望时长:
			# 这一趟查完了，把记性清掉 —— 不然刚转身又被同一件事拉回来
			h._听觉剩余 = 0.0
			h._听觉音量 = 0.0
			机器().切(状态名.巡逻)
		return

	# 走过去。速度按音量插值：小声慢慢挪，大声直接冲
	var 速度: float = lerpf(h.巡逻速度, h.追击速度, h._听觉音量)
	if not h._朝目标走(h._听觉目标.x, 速度, delta):
		_到了 = true    # 撞墙 / 到崖边：走不过去，就地看看
