extends "res://组件/状态机/状态.gd"
## 开门 —— 追人 / 循声的路上被一扇关着的门挡住：站定把它推开，门开了再继续追。
##
## 【为什么必须有这个状态】
## 一扇关着的门对 AI 就是一堵 96px 高的墙，`_朝目标走()` 会判「跳不过去」直接站住。
## 没有它，玩家只要把门关上，她就永久被锁在门外 ——
## 「关门买 1.5 秒」这条设计会退化成「关门 = 无敌」，整个追逃就没了。
##
## 【为什么是「站定」而不是「边推边走」】
## 她推门走的是门自己的开关动画（宿管 1.5 秒）。这段时间挡路体还在，她本来就挤不过去，
## 往前走只会贴着门板抖。站定读秒、读完了门自己开，比「一直撞门」干净得多。
##
## 【只开不关】
## 走的是 `门.求开()`，不是 `press()`。`press()` 是开关切换，而 AI 每帧都会问
## 「门还在不在挡路」，连问两帧就会开→关→开→关地抽搐，而且永远过不去。
##
## 【什么时候进来、什么时候出去】
## 进来：`宿管.抢占()` 的第二条（有目标或还记得一声响，且正前方有扇推得开的关着的门）。
## 出去：门开了（挡路体撤掉，`_挡路的门()` 返回 null）→ 回追击 / 循声 / 巡逻。

const 状态名 := preload("res://角色/宿管/状态/状态名.gd")


func 进入(_上个: String = "") -> void:
	pass


func 离开(_下个: String = "") -> void:
	host._在推的门 = null


func 每帧(delta: float) -> void:
	var h = host
	var 方向: float = h._朝向目标(h._看得见的目标())
	var 门 = h._挡路的门(方向)

	# 门开了（挡路体撤了）/ 方向变了：交出去。
	# **这一步必须自己切走**：抢占在「没人、也没线索」时会返回空串，
	# 光靠它的话她会永远站在门口不动。
	if 门 == null:
		机器().切(状态名.搜索 if h._有记忆() else h.decide())
		return

	h._在推的门 = 门
	if 方向 != 0.0:
		h._面朝(方向)

	# 站定推门：门就在鼻子前面，再往前挤也只是挤门板
	h.velocity.x = move_toward(h.velocity.x, 0.0, h.FRICTION * delta)
	if not h.is_on_floor():
		h.velocity.y += h.GRAVITY * delta
	h.move_and_slide()

	门.求开(h)          # 幂等：已经在开了就什么都不做，不会把门关回去
