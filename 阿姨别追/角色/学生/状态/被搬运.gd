extends "res://组件/状态机/状态.gd"
## 被搬运 —— 身体不由自己做主：被别人扛着走（宿管抓人、队友搬你），或被队友扔在空中。
##
## 【2026-11-11 改名】原名「被拎」。改叫「被搬运」是因为它管的不只是被人拎上肩，
## 还包括被扔在空中那一段 —— 「拎」只说了其中一种情况，名字和内容对不上。
##
## 被扛着时：位置由扛你的人每帧设置，碰撞体已禁用，本状态基本没有事做 ——
##   唯一能干的活是「被队友拖着时按跳挣开」（见下面 `每帧`）。
## 在空中时：位置由 `组件/抛投/` 推进（和箱子同一套抛物线），落地自己把碰撞体挂回去。
## reparent 与碰撞体开关在 `student.gd` 的 `被扛起()` / `被放下()` / `抛出去()` 里完成。

func 每帧(delta: float) -> void:
	var h = host

	# 正被扔在空中：这一帧只推进抛物线，别的都不管
	if h._抛投.在飞:
		h._飞(delta)
		return

	# ── 被队友拖着走时按跳：挣开 ──────────────────────────
	# 三道门槛，缺一不可：
	#   ① 只认「此刻正在被玩家操作的那个」—— 不然扛人的那位按跳，
	#      顺手就把肩上的人放掉了（扛 3 档时他自己本来就跳不起来）；
	#   ② 瘫着挣不开、被宿管扛着也挣不开 —— 这两条在 `student.gd` 的 `挣脱()` 里挡，
	#      判据分别是 `瘫痪` 和 `被同伴扛着()`（只认 "student" 组）。
	if not h.被扛着:
		return
	if Director.当前控制 != h:
		return
	if Input.is_action_just_pressed("jump"):
		h.挣脱()
