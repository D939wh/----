extends Node2D
## 物件代理 —— 全场景**只有一个**（2026-11-06 按编号重构，替换掉原来「每层一个」的楼层代理）
##
## 【它干什么】开局读一张平表（`数据/正式/物件清单.gd`），照单把东西建出来，
##   建一个就在总管那儿登记一个编号。之后就不管了 —— 谁按什么键、开哪扇门，
##   由总管按编号把话递给那件东西自己办（见 `单例/场景总管.gd` 的 `交互`）。
##
## 【为什么不再每层一个】主人 11-06 说：「我的技术框架里面从来没有要求你们这样子
##   按楼层去分，调整成按编号区分。」按楼层分，四层楼要摆四个空节点、清单分四组、
##   还要给每层算一段「层带」告诉总管人在第几楼。按编号分，这些全不需要：
##   人只报「我碰到了编号 X」，跟它在几楼没关系。
##
## 【怎么加一种新东西】两处：
##   ① 下面 `类型场景` 里加一行 `"灯": preload("res://交互物/灯/灯.tscn")`；
##   ② 打开灯的场景，把脚本里 `setup()` 的签名对齐（见下面的 match）。
##   就这些。清单里写 `"类型": "灯"` 就会被建出来，学生、总管一个字不用改。
##
## 【为什么要求"编号 + 类型"两栏】编号是身份证（谁是谁），类型决定拿哪个场景来建。
##   没有编号 → 建出来也没人找得到它；没有类型 → 不知道该建什么。两种都当场报错。

## 类型 → 场景。**加新物件只改这一张表**
const 类型场景 := {
	"门": preload("res://交互物/门/门.tscn"),
	"钥匙板": preload("res://交互物/钥匙板/钥匙板.tscn"),
	"锁口": preload("res://交互物/锁口/锁口.tscn"),
	"出口": preload("res://交互物/出口/出口.tscn"),
	"检修口": preload("res://交互物/检修口/检修口.tscn"),
	"箱子": preload("res://交互物/可搬运箱子/可搬运箱子.tscn"),
	"道具": preload("res://交互物/可使用物品/可使用物品.tscn"),
	# 梯子：图块只画了外观，能爬靠这个判定框（2026-11-06 主场景3）
	"梯子": preload("res://交互物/梯子/梯子.tscn"),
}

## 用哪张清单。**每张地图自己声明**，两个去处：
##   正式地图 → `res://数据/正式/物件清单.gd`
##   测试布景 → `res://数据/测试/物件清单_旧一楼.gd`
##
## 【为什么填路径而不填资源】（2026-11-06 实测）
##   `@export var 清单: Script` 在 4.7 里能从检查器赋值，但存进 .tscn 读回来是 null
##   （属性存在、就是没被赋上值，静默失败 —— 代理照旧用默认那张表，看起来一切正常）。
##   换成字符串路径 + load()，一样能换表，而且出错会当场报出来。
##   同理：导出属性名一律用英文，中文名在 .tscn 里赋值会静默失效。
@export_file("*.gd") var list_path: String = ""

## 这张图一共建出来几件（自测和排查用）
var 已建数: int = 0


func _ready() -> void:
	# 漏填 = 当场报错，不退回任何「默认表」。宁可空着报红，
	# 也不要它悄悄去读另一张（测试）表、把坐标算到别的图上。
	if list_path == "":
		push_error("[物件代理] 没填 list_path —— 每张地图都必须自己声明用哪份清单")
		return
	var 装 = load(list_path)
	if not (装 is Script):
		push_error("[物件代理] 清单路径读不出脚本：%s" % list_path)
		return
	var 表: Dictionary = 装.物件
	_照单建(表)
	print("[物件代理] 照清单建了 %d 件（清单里一共 %d 条）" % [已建数, 表.size()])


## 照单全部建出来。**一件建不成，不影响别的** —— 报清楚哪一条、为什么，
## 剩下的照样摆出来，别因为一盏灯配错就让整张图空着。
func _照单建(表: Dictionary) -> void:
	for 编号 in 表:
		var 条目: Dictionary = 表[编号]
		_建一件(str(编号), 条目)


func _建一件(编号: String, 条目: Dictionary) -> void:
	var 类型: String = str(条目.get("类型", ""))
	if 类型 == "":
		push_error("[物件代理] 「%s」没写「类型」，不知道该建什么" % 编号)
		return
	var 场: PackedScene = 类型场景.get(类型, null)
	if 场 == null:
		push_error("[物件代理] 「%s」的类型是「%s」，但代理不认识这种（认识的：%s）" % [
			编号, 类型, 类型场景.keys()])
		return
	if not 条目.has("位置"):
		push_error("[物件代理] 「%s」没写「位置」" % 编号)
		return

	var 物: Node2D = 场.instantiate()
	# 编号要在 add_child **之前** 盖上：_ready 里各物件会拿它去总管那儿报到，
	# add_child 那一刻 _ready 就跑了，晚一步盖就登记成空编号。
	if "编号" in 物:
		物.set("编号", 编号)
	add_child(物)
	_配置(物, 类型, 编号, 条目)
	Director.register_thing(编号, 物)
	已建数 += 1


## 按类型喂参数。**这是唯一知道"每种东西要什么参数"的地方**
## （清单里写的是人类看得懂的键，翻译成 setup 的位置）
func _配置(物: Node2D, 类型: String, 编号: String, 条目: Dictionary) -> void:
	var 位置: Vector2 = 条目["位置"]
	match 类型:
		"门":
			# 用时 = 默认（通用规则）+ 这一扇的覆盖。规则不属于任何一张图。
			物.setup(位置, 规则.开门用时(条目))
		"钥匙板":
			# 颜色从规则表取 —— 和门上的锁孔是同一份，不会「钥匙黄、孔红」
			物.setup(位置, 规则.钥匙板配色.get(编号, Color.WHITE))
		"锁口":
			物.setup(
				位置,
				float(条目.get("插孔用时", 2.0)),
				str(条目.get("连哪扇门", ""))
			)
		"出口":
			物.setup(
				位置,
				str(条目.get("等的门", "")),
				float(条目.get("站多久", 1.0))
			)
		"检修口":
			物.setup(位置.x, 位置.y, float(条目.get("宽", 32.0)))
		"梯子":
			# 只有图块画的图才需要它：`显示贴图` 默认 false —— 图上已经画了梯子，
			# 再叠一张 `梯子.png` 会错位。老地图手摆的梯子不经过这里，贴图照旧显示。
			物.setup(
				位置,
				float(条目.get("高", 300.0)),
				float(条目.get("宽", 32.0)),
				bool(条目.get("显示贴图", false))
			)
		"箱子", "道具":
			# 这两样只要摆对位置，其余参数在场景里（重量、贴图）
			物.position = 位置
		_:
			# 类型表里认识的，这里没写配置 = 新加类型时漏了一步
			push_error("[物件代理] 类型「%s」没有配置分支，%s 摆不上（在 _配置 里补一段）" % [
				类型, 编号])


## 全局规则：**对所有地图生效**的那份数（开门用时、钥匙板配色/编号）。
## 和清单分开：清单只属于某一张图，规则属于整个工程。
const 规则 = preload("res://数据/通用规则.gd")
