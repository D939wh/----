extends Node
## 剧情 —— 判定区把「路由名 + 谁踩进来的」报到这里，这里照 `数据/剧情表.gd` 演一遍。
##
## 【它只做三件事】查表 → 按「动作」分枝 → 把参数递给干活的模块。
## 它不许认识具体名词（阿姨、走廊、大门……那些只活在表里），
## 也不许自己算位置、自己 new 节点 —— 那是 `Summon` 的事。
##
## 【为什么中间要隔这一层】
##   判定区只认「路由名」，不认识戏；演出内容全在表里；真正动手的是各模块。
##   于是三件事可以分开改：加一块判定区（改清单）、换一出戏（改表）、
##   改摆位数学（改 Summon）—— 互不牵连。
##
## 【动作】现在只有一种：
##   "召唤" → `Summon.生成(场景, 参照=踩进来的人, 摆位)`，参数表里给：
##            场景 / 方位 / 留白 / 贴地 / 位置 / 名字
##   以后要「关灯」「锁门」「放音效」，在这里加一个 match 分支，表里加一行就行。
##
## 【挂载名】autoload 名是 `Story`（纯英文；中文挂载名会被引擎按 Latin-1 解成乱码）。

## 一出戏开演了。谁想跟着做点什么（播音效、记进度）就听这个，别去改判定区。
signal 剧情开始(名字: String, 谁: Node)

const 表 := preload("res://数据/剧情表.gd")


## 演一出戏。名字 = 剧情表里的键（判定区的「路由」写的就是它）。
## 返回 true = 真演了；false = 表里没这条 / 动作不认识（两种情况都会报错，不静默失败）。
func 触发(名字: String, 谁: Node = null) -> bool:
	var 条 = 表.剧情.get(名字, null)
	if 条 == null:
		push_error("[剧情] 没有这条戏：%s（表里有的：%s）" % [名字, 表.剧情.keys()])
		return false

	var 动作 := str(条.get("动作", ""))
	match 动作:
		"召唤":
			Summon.生成(_场景(条), 谁, _摆位(条))
		_:
			push_error("[剧情] 「%s」的动作是「%s」，不认识（认识的：召唤）" % [名字, 动作])
			return false

	print("[剧情] 开演：%s（%s）" % [名字, 动作])
	剧情开始.emit(名字, 谁)
	return true


## 表里的 `场景` 原样交给召唤模块去解析（它认 PackedScene 也认 res:// 路径）
func _场景(条: Dictionary):
	return 条.get("场景", "")


## 只把**摆位**相关的键挑出来递过去 —— 表里其它键（说明 / 动作 / 场景）
## 不是摆位参数，混进去会让摆位规则变得难查。`名字` 算摆位的一部分（生成时就用它命名）。
func _摆位(条: Dictionary) -> Dictionary:
	const 摆位键 := ["方位", "留白", "贴地", "位置", "名字"]
	var 结果 := {}
	for 键 in 摆位键:
		if 条.has(键):
			结果[键] = 条[键]
	return 结果
