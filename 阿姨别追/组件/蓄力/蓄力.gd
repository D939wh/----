extends RefCounted
## 蓄力 —— 「按住攒力，松手结算」。
##
## 【它管什么】只记时间：攒了多久、攒到几成、要不要顺手挂一根力条显示。
##   攒满之后干什么、往哪边、算多远，全是宿主的事 —— 这个文件里没有一句
##   在判断游戏规则，连按的是哪个键都不认识（谁调 `推进`，谁自己报时间）。
##
## 【谁在用】学生（按住 F 扔箱子 / 扔队友，见 `student.gd` 的 `_开始蓄力`）。
##   宿管蓄力挥击、撬棍撬门这类「按得越久越狠」的动作，可以直接拿去用。
##
## 【和 `组件/抛投/` 的分工】这里只到「攒了多大力（0~1）」为止；
##   力怎么变成初速、抛物线怎么飞，是 `组件/抛投/` 的事。两个各管一段。
##
## 【怎么用】
##   const 蓄力 := preload("res://组件/蓄力/蓄力.gd")
##   var _蓄力 = 蓄力.new()
##   _蓄力.满蓄时长 = 0.8               # 手感数值由宿主定
##   _蓄力.读条条 = 我的读条()           # 可选，不给就纯计时、不显示
##   _蓄力.开始(self)                    # 按下那一刻
##   _蓄力.推进(delta)                   # 每帧
##   var 比例 := _蓄力.松开()            # 松手 → 0~1（0 = 没攒，1 = 满）
##   _蓄力.取消()                        # 被打断 / 切状态 / 东西脱手

## 按住多久算攒满（秒）。宿主按自己的手感设，这里只给个默认值，不替谁定规则。
var 满蓄时长: float = 0.8

## 想显示力条就塞一根进来（`界面/读条/` 的那个节点）；留空 = 纯计时。
var 读条条: CanvasLayer = null

## 力条上的字。空字符串 = 只显示秒数。
var 读条标题: String = "蓄力"

var _在蓄: bool = false
var _进度: float = 0.0        # 已经按了多久（秒）


## 按下：开始攒力，并把力条挂到 `宿主` 头顶。
## 已经在蓄力时再调不会重置 —— 连按不该把攒好的力打回 0。
func 开始(宿主: Node2D) -> void:
	if _在蓄:
		return
	_在蓄 = true
	_进度 = 0.0
	if _读条活着():
		读条条.开始(宿主, 读条标题, 满蓄时长)


## 每帧推进。攒满就停在那儿，不溢出（比例永远是 0~1）。
func 推进(delta: float) -> void:
	if not _在蓄:
		return
	_进度 = minf(_进度 + delta, 满蓄时长)
	if _读条活着():
		读条条.推进(_进度)


## 松手：把这次的力换算成 0~1 的比例，然后收干净。
## 没在蓄力时返回 0.0 —— 调用方不用先问一句「我在蓄力吗」。
func 松开() -> float:
	if not _在蓄:
		return 0.0
	var 结果 := 比例()
	取消()
	return 结果


## 作废：东西还在宿主手上，力条收掉。被打断 / 切状态 / 被扛走都走这里，
## 可以重复调（已经在收着也不报错）。
## 【2026-11-11 修】没在蓄力时**不许碰读条**：读条是宿主共用的那**一根**
## （学生的力条和锁口插钥匙借的是同一个节点），没在蓄力还去收，
## 会把别人正在用的条顺手收掉 —— 实际症状是「按 R 插钥匙，头顶的读条一闪就没了」。
func 取消() -> void:
	if not _在蓄:
		return          # 本来就没在蓄力：不碰读条，别人的条不归我收
	_在蓄 = false
	_进度 = 0.0
	if _读条活着():
		读条条.收()


func 在蓄力() -> bool:
	return _在蓄


## 现在攒到几成（0~1）。还没松手也想问，随时可以问。
func 比例() -> float:
	return clampf(_进度 / maxf(满蓄时长, 0.001), 0.0, 1.0)


## 攒满了没有。宿主想让力条变色 / 抖一下 / 出提示时问这个。
func 满了() -> bool:
	return _在蓄 and _进度 >= 满蓄时长


## 读条节点还在不在。用的人可能被删，条会跟着消失 —— 每次用之前都得问一句。
func _读条活着() -> bool:
	return 读条条 != null and is_instance_valid(读条条)
