extends RefCounted
## 状态机 —— 一个实体挂一台，状态对象由实体在 `_ready` 里注册。
##
## 【它管什么】只管「这一帧该跑哪个状态」，不管状态里干什么。
##   进入/每帧/离开全在各自的脚本里，**这个文件里没有一个 if 是在判断游戏规则**。
##
## 【两种切换】
##   `切(名字)`    硬切：切完本帧到此为止。
##   `软切(名字)`  软切：切完本帧继续跑新状态。
##   绝大多数地方用 `切`；`软切` 只在「这一帧还要接着做事」时用（本工程目前没用到）。
##
## 【抢占：优先级写在一处】
##   每帧先问实体一句 `host.抢占(当前)`，实体按优先级回答「该切到谁」。
##   回答空串 = 不用抢。「被扛 > 瘫痪 > 插钥匙 > 旁观 > 攀爬」这套先后关系是一张**能读的表**。
##
## 是 RefCounted 不是 Node：不进场景树、不需要 _process、检查器里没有要填的东西。

## 一帧内最多连切几次。防「A 切 B、B 又切回 A」互相踢皮球，把一帧卡死。
const 最大连切 := 4

var host                       # 所属实体
var _状态表 := {}              # 状态名 -> 状态对象
var _当前: String = ""
var _本帧切过 := false          # 当前状态的 `每帧` 里有没有发起过切换
var _硬切 := true              # 上一次切换是不是硬切


## 注册一个状态。顺手把 host 灌给它 —— 状态脚本里不用自己管这件事。
## 必须在 `启动()` 之前把要用的状态都注册完。
func 加(名字: String, 状态对象) -> void:
	状态对象.host = host
	_状态表[名字] = 状态对象


## 开局（或重开）直接进入某状态：只跑 `进入`，不走切换流程。
func 启动(名字: String) -> void:
	_当前 = 名字
	_硬切 = true
	_状态表[_当前].进入("")


## 现在在哪个状态。给外部读数用（调试面板、自测），**不要拿它来写游戏规则**——
## 「现在是攀爬就怎样」这种判断应该写在状态里。
func 当前() -> String:
	return _当前


## 硬切：切过去后本物理帧到此为止。
func 切(名字: String, 强制 := false) -> void:
	_真正切(名字, 强制, true)


## 软切：切过去后本帧继续跑新状态。
func 软切(名字: String) -> void:
	_真正切(名字, false, false)


## 每物理帧由实体调一次。
## 顺序：抢占 → 跑当前状态 → 看有没有切走；软切就回到开头重走一遍（最多 `最大连切` 次）。
func 跑(delta: float) -> void:
	for _i in 最大连切:
		var 现在 := _当前
		# ① 先问实体：现在有没有「比我优先级更高」的状态
		var 抢: String = host.抢占(现在)
		if 抢 != "" and 抢 != 现在:
			切(抢)
			return
		# ② 跑当前状态自己的行为
		_本帧切过 = false
		_状态表[现在].每帧(delta)
		# ③ 没切 → 本帧结束；硬切 → 也结束（这就是 return 的语义）；
		#    只有软切才回到开头，带着新状态再走一遍抢占
		if not _本帧切过 or _硬切:
			return


## 真正执行一次切换：先让旧状态 `离开`，再让新状态 `进入`。
## 同名且没强制 → 什么都不做（「已经在做这件事」就靠这一句跳过）。
func _真正切(名字: String, 强制: bool, 硬: bool) -> void:
	if 名字 == _当前 and not 强制:
		return
	var 旧 := _当前
	if 旧 != "" and _状态表.has(旧):
		_状态表[旧].离开(名字)
	_当前 = 名字
	_本帧切过 = true
	_硬切 = 硬
	_状态表[_当前].进入(旧)
